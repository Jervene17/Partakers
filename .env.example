# Telegram bot token from @BotFather
SERVICE_PARTAKER_BOT_TOKEN=

# The bot's username WITHOUT the @ (from @BotFather) - used to build the
# preference-round deep links (t.me/<username>?start=...)
SERVICE_PARTAKER_BOT_USERNAME=

# The spreadsheet ID from your Google Sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
SERVICE_PARTAKER_SHEET_ID=

# Paste the FULL contents of your Google service-account JSON key here as
# one line (see README for how to create it). Must be shared as an Editor
# on the Google Sheet above.
GOOGLE_CREDS_JSON=
